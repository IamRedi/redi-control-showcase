FROM node:22.22.1-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY apps ./apps
COPY packages ./packages
COPY database ./database
COPY tsconfig*.json ./
RUN npm ci && npm run build --workspace=@redi-control/database && npm prune --omit=dev

FROM node:22.22.1-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
CMD ["node", "packages/database/dist/cli.js", "migrate"]
