# Non-secret runtime configuration for one portable production installation.
# Copy to `runtime.env`; do not place passwords, API keys or tokens here.

NODE_ENV=production
DEPLOYMENT_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

PUBLIC_WEB_ORIGIN=https://redi.example.com
PUBLIC_API_ORIGIN=https://redi.example.com
TRUSTED_PUBLIC_HOSTS=redi.example.com
SESSION_COOKIE_SECURE=true
DATA_REGION=eu

IDENTITY_ADAPTER=oidc
OIDC_ISSUER=https://redi.example.com/id/realms/redi-control
OIDC_CLIENT_ID=redi-control
OIDC_ALLOWED_ID_TOKEN_ALGS=RS256
OIDC_ACCEPTED_MFA_ACR_VALUES=redi-control-mfa
OIDC_REQUESTED_ACR_VALUES=redi-control-mfa
# Private Compose endpoint for the least-privilege Keycloak service account.
KEYCLOAK_MEMBER_PROVISIONER_ORIGIN=http://keycloak:8080/id
KEYCLOAK_MEMBER_PROVISIONER_REALM=redi-control
KEYCLOAK_MEMBER_PROVISIONER_CLIENT_ID=redi-control-member-provisioner

# Production infrastructure adapters. The S3 endpoint is vendor-neutral.
SECRET_PROVIDER_MODE=external
OPENBAO_ADDRESS=https://openbao:8200
OPENBAO_REQUEST_TIMEOUT_MS=5000
ENCRYPTION_KEY_REFERENCE=secret://production/data-encryption
OBJECT_STORAGE_MODE=s3_compatible
OBJECT_STORAGE_ENDPOINT=https://s3.example.invalid
OBJECT_STORAGE_REGION=nbg1
OBJECT_STORAGE_BUCKET=showcase-media
# Hetzner's regional endpoint is accepted through path-style addressing.
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_KEY_PREFIX=redi-control/production
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_SCANNER=external
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=180000
CLAMAV_MAX_BYTES=536870912
SOCIAL_PROVIDER_MODE=live
META_APP_ID=replace-with-meta-app-id
# Optional: Facebook Login for Business configuration using a User access token.
# META_BUSINESS_LOGIN_CONFIGURATION_ID=replace-with-meta-configuration-id

SOCIAL_OAUTH_REDIRECT_URIS=https://redi.example.com/api/social/oauth/meta/callback,https://redi.example.com/api/social/oauth/youtube/callback
WORKER_CONCURRENCY=4
WORKER_HEALTH_MAX_AGE_MS=30000
EXPECTED_MIGRATION_COUNT=44
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_FETCH_MAX_BYTES=2000000
SOURCE_FETCH_USER_AGENT=REDI-CONTROL-Source-Ingestion/1.0 (+https://redi.example.com/source-policy)
YOUTUBE_API_VERSION=v3

# Server-only URL used by the Next.js BFF. It is not browser-exposed.
CONTROL_API_URL=http://api:3001
