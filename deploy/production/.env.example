# Docker Compose interpolation only. Copy to `.env` on the server and replace
# every example value. Application secrets belong in `./secrets`, never here.

REDI_DOMAIN=redi.example.com
ACME_EMAIL=ops@example.com
REDI_VERSION=local
REDI_RUNTIME_ENV_FILE=./runtime.env
REDI_SECRETS_DIR=./secrets
REDI_HOST_UID=1000
REDI_HOST_GID=1000
REDI_CADDYFILE=./Caddyfile

# Direct HTTPS mode: forward only TCP 80/443 from the router to this host.
# For an external tunnel terminating TLS, bind to 127.0.0.1 and use the
# reviewed origin Caddyfile documented in the production runbook, for example:
# REDI_CADDYFILE=./Caddyfile.origin
# REDI_PUBLIC_BIND_ADDRESS=127.0.0.1
# REDI_HTTP_HOST_PORT=8080
REDI_PUBLIC_BIND_ADDRESS=0.0.0.0
REDI_HTTP_HOST_PORT=80
REDI_HTTPS_HOST_PORT=443

# Local encrypted PostgreSQL backup staging. The monitor requires a fresh
# `redi-control-*.dump.gpg` file here when this is configured.
# REDI_BACKUP_DIRECTORY=/absolute/private/backup-directory
# REDI_MONITOR_MAX_BACKUP_AGE_HOURS=26
# REDI_MONITOR_MAX_DISK_PERCENT=85

# Pin third-party images to reviewed immutable digests before production.
REDI_POSTGRES_IMAGE=postgres:17-alpine
REDI_CADDY_IMAGE=caddy:2-alpine
REDI_CLAMAV_IMAGE=clamav/clamav@sha256:1b6920e8c32cca47ea33b1e2611d9a4740ccc622cf13b30b29f8283d60175e39
REDI_OPENBAO_IMAGE=ghcr.io/openbao/openbao@sha256:5b2486ab0fb90bbc788cc345b0a08616dfb375873ee8be5df3a2fd4d378a67e0
REDI_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:f1f1f01e472c8a78df40d8f2a49a925274eda4d3d80d5f6edbb5c880ee3c01c6
