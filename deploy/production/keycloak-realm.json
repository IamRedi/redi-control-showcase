{
  "realm": "redi-control",
  "enabled": true,
  "displayName": "REDI CONTROL",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "browserFlow": "redi-control-browser",
  "attributes": {
    "acr.loa.map": "{\"redi-control-mfa\":2}"
  },
  "authenticatorConfig": [
    {
      "alias": "REDI CONTROL LoA 1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "1800",
        "loa-store-in-user-session": "true"
      }
    },
    {
      "alias": "REDI CONTROL LoA 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "1800",
        "loa-store-in-user-session": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "redi-control-browser",
      "description": "Exact REDI CONTROL browser flow with mandatory LoA 2",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "redi-control-forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "redi-control-forms",
      "description": "Password followed by requested MFA level",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "redi-control-level-1",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "redi-control-level-2",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "redi-control-level-1",
      "description": "Base password authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "REDI CONTROL LoA 1",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "redi-control-level-2",
      "description": "Mandatory TOTP second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "REDI CONTROL LoA 2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "redi-control",
      "name": "REDI CONTROL",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${REDI_OIDC_CLIENT_SECRET}",
      "redirectUris": ["${REDI_PUBLIC_ORIGIN}/auth/callback"],
      "webOrigins": ["${REDI_PUBLIC_ORIGIN}"],
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["web-origins", "acr", "profile", "email"],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "default.acr.values": "redi-control-mfa",
        "minimum.acr.value": "redi-control-mfa",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "require.pushed.authorization.requests": "false",
        "use.refresh.tokens": "false",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "${REDI_PUBLIC_ORIGIN}/*"
      }
    }
  ]
}
