[Unit]
Description=REDI CONTROL local production monitor
Requires=docker.service
After=docker.service network-online.target redi-control.service
Wants=network-online.target
OnFailure=redi-control-email-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=@DEPLOYMENT_DIRECTORY@
ExecStart="@DEPLOYMENT_DIRECTORY@/monitor-production.sh"
