# REDI CONTROL staging variable inventory. This file contains names and
# non-secret examples only. Never commit a populated .env.staging file.

NODE_ENV=production
DEPLOYMENT_ENV=staging
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# Replace with the final HTTPS staging origin and exact trusted host.
PUBLIC_WEB_ORIGIN=https://redi-staging.example.com
PUBLIC_API_ORIGIN=https://redi-staging.example.com
TRUSTED_PUBLIC_HOSTS=redi-staging.example.com
SESSION_COOKIE_SECURE=true
DATA_REGION=eu

# Inject these secret values at runtime; they are intentionally absent here:
# DATABASE_URL_FILE=/run/secrets/database_runtime_url
# DATABASE_AUTH_URL_FILE=/run/secrets/database_auth_url
# SOCIAL_OAUTH_STATE_SECRET
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_TRANSACTION_ENCRYPTION_KEY_FILE=/run/secrets/oidc_transaction_key

IDENTITY_ADAPTER=oidc
OIDC_ISSUER=https://identity-staging.example.com
OIDC_CLIENT_ID=redi-control-staging
OIDC_ALLOWED_ID_TOKEN_ALGS=RS256
# Optional exact ACR values asserted by the selected provider after MFA.
OIDC_ACCEPTED_MFA_ACR_VALUES=
SECRET_PROVIDER_MODE=external
ENCRYPTION_KEY_REFERENCE=secret://staging/data-encryption
OBJECT_STORAGE_MODE=s3_compatible
OBJECT_STORAGE_HEALTH_URL=https://object-storage-health.internal/health/ready
MEDIA_SCANNER=external
SOCIAL_PROVIDER_MODE=live

# Replace the host only after the staging domain is fixed.
SOCIAL_OAUTH_REDIRECT_URIS=https://redi-staging.example.com/api/social/oauth/meta/callback,https://redi-staging.example.com/api/social/oauth/youtube/callback
WORKER_CONCURRENCY=4
EXPECTED_MIGRATION_COUNT=44
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_FETCH_MAX_BYTES=2000000
SOURCE_FETCH_USER_AGENT=REDI-CONTROL-Source-Ingestion/1.0 (+https://redi-staging.example.com/source-policy)
YOUTUBE_API_VERSION=v3

# Migration job only. compose.staging.yaml mounts these as external secrets.
# DATABASE_ADMIN_URL_FILE=/run/secrets/database_admin_url
# DATABASE_RUNTIME_PASSWORD_FILE=/run/secrets/database_runtime_password
# DATABASE_AUTH_PASSWORD_FILE=/run/secrets/database_auth_password

# Immutable image references are deployment inputs, not application secrets.
# REDI_MIGRATE_IMAGE=registry.example.com/redi/migrate@sha256:...
# REDI_API_IMAGE=registry.example.com/redi/api@sha256:...
# REDI_WORKER_IMAGE=registry.example.com/redi/worker@sha256:...
# REDI_WEB_IMAGE=registry.example.com/redi/web@sha256:...
