# Local-only defaults. Never commit real credentials.
NODE_ENV=development
DEPLOYMENT_ENV=local
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
# Generate three unique local-only passwords; do not copy example secrets into production.
POSTGRES_DB=redi_control
POSTGRES_USER=redi_control_admin
POSTGRES_PORT=54329
POSTGRES_PASSWORD=replace-with-generated-local-admin-password
DATABASE_RUNTIME_PASSWORD=replace-with-generated-local-runtime-password
DATABASE_AUTH_PASSWORD=replace-with-generated-local-auth-password
DATABASE_ADMIN_URL=postgresql://redi_control_admin:replace-with-generated-local-admin-password@127.0.0.1:54329/redi_control
DATABASE_URL=postgresql://redi_control_runtime:replace-with-generated-local-runtime-password@127.0.0.1:54329/redi_control
DATABASE_AUTH_URL=postgresql://redi_control_auth:replace-with-generated-local-auth-password@127.0.0.1:54329/redi_control
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:3001
TRUSTED_PUBLIC_HOSTS=localhost,127.0.0.1
LOCAL_DEMO_MODE=false
IDENTITY_ADAPTER=unconfigured
SESSION_COOKIE_SECURE=false
DATA_REGION=eu
# Optional M3A local-only services. Generate unique values; never reuse them in production.
LOCAL_STORAGE_BASE_URL=http://127.0.0.1:9000
LOCAL_STORAGE_ROOT=.local/storage
LOCAL_STORAGE_HOST=127.0.0.1
LOCAL_STORAGE_PORT=9000
LOCAL_STORAGE_SIGNING_SECRET=replace-with-generated-32-byte-local-signing-value
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_HEALTH_URL=http://127.0.0.1:3010/health/ready
SECRET_PROVIDER_MODE=local_memory
# Staging/production: secret:// reference resolved only by the external secret provider.
# ENCRYPTION_KEY_REFERENCE=secret://staging/data-encryption
MEDIA_SCANNER=deterministic_local
SOCIAL_PROVIDER_MODE=deterministic_local
SOCIAL_OAUTH_STATE_SECRET=replace-with-generated-32-byte-local-oauth-state-value
SOCIAL_OAUTH_REDIRECT_URIS=http://127.0.0.1:3001/api/social/oauth/meta/callback,http://127.0.0.1:3001/api/social/oauth/youtube/callback
WORKER_CONCURRENCY=4
EXPECTED_MIGRATION_COUNT=44
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_FETCH_MAX_BYTES=2000000
SOURCE_FETCH_USER_AGENT=REDI-CONTROL-Source-Ingestion/1.0 (+https://your-domain.example/source-policy)
# Live provider clients remain unconfigured until M3B credentials/app setup.
# META_GRAPH_API_VERSION=vXX.X
# Optional: Facebook Login for Business configuration using a User access token.
# META_BUSINESS_LOGIN_CONFIGURATION_ID=replace-with-meta-configuration-id
YOUTUBE_API_VERSION=v3
