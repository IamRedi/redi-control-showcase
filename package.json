{
  "name": "redi-control",
  "version": "0.0.0",
  "private": true,
  "description": "Local foundation for the REDI CONTROL multi-tenant control plane",
  "author": "Redion Cekrezi",
  "engines": {
    "node": ">=22.22.1 <27",
    "npm": ">=9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@redi-control/web",
    "dev:api": "npm run dev --workspace=@redi-control/api",
    "dev:worker": "npm run dev --workspace=@redi-control/worker",
    "dev:storage": "npm run dev --workspace=@redi-control/storage",
    "db:migrate": "npm run migrate --workspace=@redi-control/database",
    "db:seed": "npm run seed --workspace=@redi-control/database",
    "db:verify": "npm run verify --workspace=@redi-control/database",
    "identity:invite-first-owner": "npm run invite-first-owner --workspace=@redi-control/identity",
    "infra:up": "docker compose up -d --wait postgres object-storage",
    "infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "node scripts/verify-rws-standard.mjs && prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "npm run typecheck && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "security:secrets": "bash scripts/scan-secrets.sh",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p scripts/tsconfig.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "check:full": "npm run check && npm run test:integration && npm audit",
    "check:containers": "docker build -f deploy/Dockerfile.migrate -t redi-control/migrate:check . && docker build -f deploy/Dockerfile.api -t redi-control/api:check . && docker build -f deploy/Dockerfile.worker -t redi-control/worker:check . && docker build -f deploy/Dockerfile.web -t redi-control/web:check .",
    "check:production": "node scripts/check-production-compose.mjs",
    "check:hetzner": "npm run check:production",
    "storage:probe": "tsx scripts/probe-s3-storage.ts",
    "demo:prepare": "tsx scripts/prepare-local-demo.ts",
    "demo:start": "bash scripts/local-demo.sh start",
    "demo:refresh": "bash scripts/local-demo.sh refresh",
    "demo:status": "bash scripts/local-demo.sh status",
    "demo:stop": "bash scripts/local-demo.sh stop",
    "businesssite:probe": "tsx scripts/probe-businesssite-phase7.ts",
    "openbao:probe": "tsx scripts/probe-openbao.ts",
    "openbao:upload-recovery": "tsx scripts/upload-openbao-recovery.ts",
    "postgres:upload-backup": "tsx scripts/upload-postgres-backup.ts",
    "pilot:6p": "tsx scripts/pilot-6p.ts",
    "test:showcase": "node scripts/showcase-acceptance.mjs --managed",
    "showcase:offline-check": "node scripts/check-showcase-offline.mjs",
    "showcase:verify": "node scripts/verify-showcase.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "eslint": "10.0.2",
    "prettier": "3.8.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.0"
  }
}
